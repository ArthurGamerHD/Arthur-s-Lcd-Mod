<UserControl xmlns="https://github.com/ArthurGamerHD/Adk"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Arthur_s_Lcd_Mod.Gui.Tests"
             x:Class="Arthur_s_Lcd_Mod.Gui.Tests.StringFormatBindingView"
             x:DataType="local:StringFormatBindingModel">
  <Grid>
    <TextBlock x:Name="Composite" Text="{Binding Value, StringFormat='L/R {0:0.00}m'}" />
    <TextBlock x:Name="Bare" Text="{Binding Value, StringFormat=N2, ConverterCulture=pt-BR}" />
    <TextBlock x:Name="Quoted" Text="{Binding Value, StringFormat='{0,8:0.0} m', ConverterCulture=en-US}" />
    <TextBlock x:Name="Converted" Text="{Binding Value, Converter={StaticResource Double}, StringFormat='Value {0:0.00}', ConverterCulture=en-US}" />
    <TextBlock x:Name="NullValue" Text="{Binding Optional, StringFormat='Value [{0}]'}" />
    <Border x:Name="Numeric" Width="{Binding NumericValue, StringFormat='ignored {0}'}" />
    <Button x:Name="ObjectValue" Content="{Binding Value, StringFormat='Object {0:0.0}', ConverterCulture=en-US}" />
  </Grid>
</UserControl>
