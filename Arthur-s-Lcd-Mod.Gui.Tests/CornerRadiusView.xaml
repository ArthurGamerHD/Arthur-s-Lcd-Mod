<UserControl xmlns="https://github.com/ArthurGamerHD/Adk"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Arthur_s_Lcd_Mod.Gui.Tests"
             x:Class="Arthur_s_Lcd_Mod.Gui.Tests.CornerRadiusView"
             x:DataType="local:CornerRadiusModel">
  <StackPanel>
    <Border x:Name="BoundBorder" CornerRadius="{Binding Radius}" />
    <Border x:Name="UniformBorder" CornerRadius="6" />
    <Border x:Name="PerCornerBorder" CornerRadius="6 6 0 0" />
  </StackPanel>
</UserControl>
