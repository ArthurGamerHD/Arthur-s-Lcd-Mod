  <ItemGroup>
    <None Update="Data\Mus_victory_KA_1.xwm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\Spazzmatica_Polka.xwm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\External\Adk\Adk.Analyzer\Adk.Analyzer.csproj"
