    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Arthur-s-Lcd-Mod\Client\Markdown\**\*.cs" LinkBase="MarkdownSource" />
    <Compile Include="..\Arthur-s-Lcd-Mod\Common\Config\OptionalValue.cs" LinkBase="ConfigSource" />
