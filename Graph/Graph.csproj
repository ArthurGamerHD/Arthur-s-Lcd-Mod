<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netframework48</TargetFramework>
        <RootNamespace>Graph</RootNamespace>
        <LangVersion>6</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Configurations>Release;Debug</Configurations>
        <Platforms>x64</Platforms>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="2.1.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Mal.Mdk2.ModPackager" Version="2.2.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Mal.Mdk2.References" Version="2.2.8" />
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="Content\*\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AdditionalFiles>
        <AdditionalFiles Include="thumb.png" Condition="Exists('thumb.png')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AdditionalFiles>
        <AdditionalFiles Remove="Content\*\**\*.cs"/>
        <AdditionalFiles Remove="Content\Other content folders"/>
        <AdditionalFiles Remove="Content\Data\SBC files can go here"/>
        <None Remove="thumb.png"/>
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Content\Textures\" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\LcdModCodeGenerator\LcdModCodeGenerator.csproj"
                        OutputItemType="Analyzer"
                        ReferenceOutputAssembly="false" />
    </ItemGroup>


    <PropertyGroup>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)\Generated</CompilerGeneratedFilesOutputPath>
        <GeneratedObjDir>$(BaseIntermediateOutputPath)Generated</GeneratedObjDir>
        <MdkGeneratedRootPrefix>__MdkGenerated_</MdkGeneratedRootPrefix>
    </PropertyGroup>

    <Target Name="CleanupStaleMdkGeneratedRootFiles" BeforeTargets="CoreCompile">
        <ItemGroup>
            <_StaleMdkGeneratedRootFiles Include="$(MSBuildProjectDirectory)\$(MdkGeneratedRootPrefix)*.cs" />
        </ItemGroup>
        <Delete Files="@(_StaleMdkGeneratedRootFiles)" />
    </Target>

    <Target Name="PrepareGeneratedSourcesForMdkPack" BeforeTargets="MdkPack">
        <ItemGroup>
            <_GeneratedFilesForMdk Include="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
            <_GeneratedFilesForMdkRoot Include="@(_GeneratedFilesForMdk)" />
        </ItemGroup>

        <Copy SourceFiles="@(_GeneratedFilesForMdkRoot)"
              DestinationFiles="@(_GeneratedFilesForMdkRoot->'$(MSBuildProjectDirectory)\$(MdkGeneratedRootPrefix)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CleanupGeneratedSources" AfterTargets="MdkPack;MdkDidNotPack">
        <ItemGroup>
            <_GeneratedFiles Include="$(CompilerGeneratedFilesOutputPath)\**\*.*" />
            <_MdkGeneratedRootFiles Include="$(MSBuildProjectDirectory)\$(MdkGeneratedRootPrefix)*.cs" />
        </ItemGroup>

        <RemoveDir Directories="$(GeneratedObjDir)" />
        <MakeDir Directories="$(GeneratedObjDir)" />

        <Copy SourceFiles="@(_GeneratedFiles)"
              DestinationFiles="@(_GeneratedFiles->'$(GeneratedObjDir)\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />

        <RemoveDir Directories="$(CompilerGeneratedFilesOutputPath)" />
        <Delete Files="@(_MdkGeneratedRootFiles)" />
    </Target>
</Project>
