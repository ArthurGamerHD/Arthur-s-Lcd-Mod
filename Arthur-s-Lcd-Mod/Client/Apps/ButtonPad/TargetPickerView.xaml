<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/ArthurGamerHD/AcruxUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pad="using:LcdMod.Client.Apps.ButtonPad"
        xmlns:ext="using:LcdMod.Client.Apps.Views.Extensions"
        x:Class="LcdMod.Client.Apps.ButtonPad.TargetPickerView"
        x:DataType="pad:TargetPickerViewModel"
        Design.DataContext="{x:Static pad:TargetPickerViewModelPreview.Default}"
        Title="{ext:loc LcdMod_ButtonPad_TargetDialog_Title}" Width="440" Height="440" MinWidth="330" MinHeight="275"
        Padding="14 4 14 14">
  <Window.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Toolkit/Dialogs.xaml" />
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/Panels.xaml" />
  </Window.Styles>
  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">
    <Grid Grid.Column="1" ColumnDefinitions="*,150" Height="36" Margin="0 0 0 8" IsVisible="{Binding IsRegular}">
      <TextBox Classes="clearButton" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{ext:loc LcdMod_ButtonPad_TargetDialog_SearchPlaceholder}">
        <TextBox.InnerLeftContent>
          <Border Classes="search-icon">
            <Border.OpacityMask>
              <ImageBrush Source="Search" Stretch="Uniform" />
            </Border.OpacityMask>
          </Border>
        </TextBox.InnerLeftContent>
      </TextBox>
      <Border x:Name="KindHost" Grid.Column="1" Margin="8 0 0 0" />
    </Grid>
    <!-- Pre-migration compact layout: search over the kind filter in a narrow column beside the list. -->
    <Grid Grid.RowSpan="2" Width="124" RowDefinitions="*,*" Margin="0 0 4 0" IsVisible="{Binding IsCompact}">
      <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{ext:loc LcdMod_ButtonPad_TargetDialog_SearchPlaceholder}"
               Margin="0 0 0 2" />
      <Border x:Name="CompactKindHost" Grid.Row="1" Margin="0 2 0 0" />
    </Grid>
    <Border Grid.Row="1" Grid.Column="1" Classes="dialog-panel">
      <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pad:PickerRow">
                <Button Margin="{Binding RowMargin}" Classes="{Binding Classes}" Command="{Binding Command}" Height="{Binding RowHeight}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Image Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}" Margin="{Binding IconMargin}" />
                    <TextBlock Grid.Column="1" Classes="dialog-text" Text="{Binding Name}" FontSize="{Binding FontSize}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Classes="dialog-muted" Text="{Binding EmptyText}" FontSize="{Binding FontSize}" IsVisible="{Binding IsEmpty}" />
      </Grid>
    </Border>
  </Grid>
</Window>
