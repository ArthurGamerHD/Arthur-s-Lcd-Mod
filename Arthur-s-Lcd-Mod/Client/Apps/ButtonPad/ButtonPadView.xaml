<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/ArthurGamerHD/AcruxUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pad="using:LcdMod.Client.Apps.ButtonPad"
    xmlns:controls="using:LcdMod.Client.Apps.Controls"
    x:Class="LcdMod.Client.Apps.ButtonPad.ButtonPadView"
    x:DataType="LcdMod.Client.Apps.ButtonPad.ButtonPadViewModel"
    Design.DataContext="{x:Static pad:ButtonPadViewModelPreview.Default}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Entries}" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemWidth="{Binding CellWidth}" ItemHeight="{Binding CellHeight}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="LcdMod.Client.Apps.ButtonPad.ActionButtonModel">
          <controls:ActionButton Title="{Binding Title}"
                                 ActionIcon="{Binding Icon}"
                                 Status="{Binding Status}"
                                 Variant="{Binding Variant}"
                                 IsConfigured="{Binding IsConfigured}"
                                 PanelColor="{Binding PanelColor}"
                                 Command="{Binding Command}"
                                 SecondaryCommand="{Binding SecondaryCommand}"
                                 Width="{Binding Size}" Height="{Binding Size}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
