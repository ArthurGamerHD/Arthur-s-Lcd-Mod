<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/ArthurGamerHD/Adk"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pad="using:LcdMod.Client.Apps.ButtonPad"
        xmlns:controls="using:LcdMod.Client.Apps.Controls"
        xmlns:ext="using:LcdMod.Client.Apps.Views.Extensions"
        x:Class="LcdMod.Client.Apps.ButtonPad.ButtonPadEntryView"
        x:DataType="pad:ButtonPadEntryViewModel"
        Title="{Binding Title}" Width="520" Height="420" MinWidth="380" MinHeight="300"
        Padding="14 4 14 14">
  <Window.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/Dialogs.xaml" />
  </Window.Styles>
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsRegular}">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Spacing="6" Margin="0 0 14 0">
          <Button Classes="dialog-preview" Command="{Binding PickSpriteCommand}" Width="96" Height="96">
            <Grid>
              <Border CornerRadius="6" Background="{Binding PreviewColor}" IsVisible="{Binding HasColor}" />
              <Image Source="{Binding PreviewIcon}" Width="60" Height="60" />
            </Grid>
          </Button>
          <Button Classes="dialog-close" Command="{Binding ClearSpriteCommand}" IsVisible="{Binding HasSprite}" HorizontalAlignment="Center">
            <controls:CloseGlyph Width="20" Height="20" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Classes="dialog-text" Text="{ext:loc LcdMod_ButtonPad_Title}" FontSize="{Binding SmallFontSize}" />
          <TextBox Text="{Binding EntryTitle, Mode=TwoWay}" PlaceholderText="{ext:loc LcdMod_ButtonPad_TitleHelp}" Height="34" />
          <TextBlock Classes="dialog-text" Text="{ext:loc LcdMod_ButtonPad_ButtonColor}" FontSize="{Binding SmallFontSize}" />
          <Grid ColumnDefinitions="Auto,*,Auto" Height="34">
            <Border Classes="dialog-icon" Width="34" Height="34" Margin="0 0 6 0">
              <Border CornerRadius="4" Margin="4" Background="{Binding PreviewColor}" />
            </Border>
            <TextBox Grid.Column="1" Classes="{Binding ColorInputClasses}" Text="{Binding ColorText, Mode=TwoWay}"
                     PlaceholderText="{ext:loc LcdMod_ButtonPad_ColorHexHelp}" MaxLength="9" />
            <Button Grid.Column="2" Classes="dialog-close" Margin="6 0 0 0" Command="{Binding ClearColorCommand}" IsVisible="{Binding HasColor}">
              <controls:CloseGlyph Width="20" Height="20" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0 6 0 0">
            <Button Classes="dialog-button" Command="{Binding PickTargetCommand}" HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="Auto,*">
                <Image Source="{Binding TargetIcon}" Width="24" Height="24" Margin="0 0 8 0" IsVisible="{Binding HasTargetIcon}" />
                <TextBlock Grid.Column="1" Classes="dialog-text" Text="{Binding TargetText}" FontSize="{Binding FontSize}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Button>
            <Button Grid.Column="1" Classes="dialog-close" Margin="6 0 0 0" Command="{Binding ClearTargetCommand}" IsVisible="{Binding HasTarget}">
              <controls:CloseGlyph Width="20" Height="20" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" Height="36">
            <Button Classes="dialog-button" Command="{Binding PickActionCommand}" IsEnabled="{Binding HasTarget}" HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="Auto,*">
                <Image Source="{Binding ActionIcon}" Width="24" Height="24" Margin="0 0 8 0" IsVisible="{Binding HasActionIcon}" />
                <TextBlock Grid.Column="1" Classes="dialog-text" Text="{Binding ActionText}" FontSize="{Binding FontSize}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Button>
            <Button Grid.Column="1" Classes="dialog-close" Margin="6 0 0 0" Command="{Binding ClearActionCommand}" IsVisible="{Binding HasAction}">
              <controls:CloseGlyph Width="20" Height="20" />
            </Button>
          </Grid>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0 10 0 0" IsVisible="{Binding IsRegular}">
      <Button Classes="dialog-button danger" Command="{Binding DeleteCommand}">
        <TextBlock Classes="dialog-text" Text="{ext:loc LcdMod_ButtonPad_Delete}" FontSize="{Binding FontSize}" />
      </Button>
      <Button Grid.Column="2" Classes="dialog-button primary" Command="{Binding ApplyCommand}">
        <TextBlock Classes="dialog-text" Text="{ext:loc LcdMod_ButtonPad_Apply}" FontSize="{Binding FontSize}" />
      </Button>
    </Grid>
    <!-- The pre-migration compact editor for very short screens: preview, two rows of fields, and the actions in a
         column on the right. -->
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsCompact}"
          ColumnDefinitions="12*,28*,46*,14*" RowDefinitions="*,*">
      <Viewbox Grid.RowSpan="2" StretchDirection="DownOnly" Margin="0 0 4 0">
        <Button Classes="dialog-preview" Command="{Binding PickSpriteCommand}" Width="96" Height="96">
          <Grid>
            <Border CornerRadius="6" Background="{Binding PreviewColor}" IsVisible="{Binding HasColor}" />
            <Image Source="{Binding PreviewIcon}" Width="60" Height="60" />
          </Grid>
        </Button>
      </Viewbox>
      <TextBox Grid.Column="1" Text="{Binding EntryTitle, Mode=TwoWay}" PlaceholderText="{ext:loc LcdMod_ButtonPad_TitleHelp}"
               Margin="0 0 4 2" />
      <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0 2 4 0">
        <Border Classes="dialog-icon" Width="28" Margin="0 0 4 0">
          <Border CornerRadius="4" Margin="4" Background="{Binding PreviewColor}" />
        </Border>
        <TextBox Grid.Column="1" Classes="{Binding ColorInputClasses}" Text="{Binding ColorText, Mode=TwoWay}"
                 PlaceholderText="{ext:loc LcdMod_ButtonPad_ColorHexHelp}" MaxLength="9" />
      </Grid>
      <Button Grid.Column="2" Classes="dialog-button" Command="{Binding PickTargetCommand}" HorizontalContentAlignment="Stretch"
              MinWidth="0" MinHeight="0" Margin="0 0 4 2">
        <Grid ColumnDefinitions="Auto,*">
          <Image Source="{Binding TargetIcon}" Width="24" Height="24" Margin="0 0 8 0" IsVisible="{Binding HasTargetIcon}" />
          <TextBlock Grid.Column="1" Classes="dialog-text" Text="{Binding TargetText}" FontSize="{Binding FontSize}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Button>
      <Button Grid.Column="2" Grid.Row="1" Classes="dialog-button" Command="{Binding PickActionCommand}" IsEnabled="{Binding HasTarget}"
              HorizontalContentAlignment="Stretch" MinWidth="0" MinHeight="0" Margin="0 2 4 0">
        <Grid ColumnDefinitions="Auto,*">
          <Image Source="{Binding ActionIcon}" Width="24" Height="24" Margin="0 0 8 0" IsVisible="{Binding HasActionIcon}" />
          <TextBlock Grid.Column="1" Classes="dialog-text" Text="{Binding ActionText}" FontSize="{Binding FontSize}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Button>
      <Button Grid.Column="3" Classes="dialog-button danger" Command="{Binding DeleteCommand}" MinWidth="0" MinHeight="0"
              Margin="0 0 0 2">
        <TextBlock Classes="dialog-text" Text="{ext:loc LcdMod_ButtonPad_Delete}" FontSize="{Binding FontSize}" />
      </Button>
      <Button Grid.Column="3" Grid.Row="1" Classes="dialog-button primary" Command="{Binding ApplyCommand}" MinWidth="0"
              MinHeight="0" Margin="0 2 0 0">
        <TextBlock Classes="dialog-text" Text="{ext:loc LcdMod_ButtonPad_Apply}" FontSize="{Binding FontSize}" />
      </Button>
    </Grid>
  </Grid>
</Window>
