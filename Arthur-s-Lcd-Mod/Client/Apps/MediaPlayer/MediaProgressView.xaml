<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/ArthurGamerHD/Adk"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="using:LcdMod.Client.Apps.MediaPlayer"
             xmlns:controls="using:LcdMod.Client.Apps.Controls"
             x:Class="LcdMod.Client.Apps.MediaPlayer.MediaProgressView"
             x:DataType="media:MediaPlayerViewModel">
  <media:MediaProgress x:Name="Progress" PositionSeconds="{Binding PositionSeconds}" DurationSeconds="{Binding DurationSeconds}"
                       CanSeek="{Binding CanSeek}" TextColor="{Binding Foreground}" TrackColor="{Binding InactiveSurfaceColor}"
                       FillColor="{Binding ActiveColor}" FontFamily="{Binding TextFont}" LayoutScale="{Binding LayoutScale}" />
</UserControl>
