<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/ArthurGamerHD/Adk"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="using:LcdMod.Client.Apps.MediaPlayer"
             xmlns:controls="using:LcdMod.Client.Apps.Controls"
             x:Class="LcdMod.Client.Apps.MediaPlayer.MediaPlaylistOverlayView"
             x:DataType="media:MediaPlayerViewModel">
  <Grid ColumnDefinitions="Auto * Auto" RowDefinitions="* *">
    <Button Classes="media-action" Command="{Binding ClearQueueCommand}" IsEnabled="{Binding QueueHasItems}"
            Background="{Binding QueueActionColor}" CornerRadius="{Binding OverlayActionRadius}" Width="{Binding OverlayActionWidth}">
      <media:MediaGlyph Kind="StopSquare" GlyphColor="{Binding ErrorColor}" SizeRatio="0.42" />
    </Button>
    <Button Grid.Row="1" Classes="media-action" Command="{Binding SaveQueueCommand}" IsEnabled="{Binding QueueHasItems}"
            Background="{Binding QueueActionColor}" CornerRadius="{Binding OverlayActionRadius}" Width="{Binding OverlayActionWidth}"
            Margin="{Binding OverlayRowGapMargin}">
      <media:MediaGlyph Kind="Save" GlyphColor="{Binding Foreground}" />
    </Button>
    <Border Grid.Column="1" Grid.RowSpan="2" Classes="media-list" Background="{Binding InactiveSurfaceColor}"
            CornerRadius="{Binding ListRadius}" Margin="{Binding OverlayListMargin}">
      <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="media:MediaPlaylistRowModel">
                  <media:MediaPlaylistRow Classes="media-row" Height="{Binding RowHeight}" IsCurrent="{Binding IsCurrent}"
                                          HandleWidth="{Binding HandleWidth}" Command="{Binding Command}" Padding="{Binding RowPadding}">
                    <Grid ColumnDefinitions="Auto * Auto">
                      <controls:SpriteIcon Source="{Binding Icon}" Tint="{Binding IconColor}" SizeRatio="1" Width="{Binding IconSize}"
                                           Height="{Binding IconSize}" Margin="0 0 8 0" IsVisible="{Binding IsNormal}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding IsNormal}">
                        <TextBlock Classes="media-row-text" Text="{Binding Title}" FontSize="{Binding TitleFontSize}"
                                   Foreground="{Binding TitleColor}" />
                        <TextBlock Classes="media-row-text" Text="{Binding Detail}" FontSize="{Binding DetailFontSize}"
                                   Foreground="{Binding DetailColor}" Margin="0 2 0 0" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="media-row-text" Text="{Binding CompactText}" FontSize="{Binding CompactFontSize}"
                                 Foreground="{Binding TitleColor}" VerticalAlignment="Center" IsVisible="{Binding IsCompact}" />
                      <media:MediaGlyph Grid.Column="2" Kind="Playlist" GlyphColor="{Binding DetailColor}" Width="{Binding HandleWidth}"
                                        Margin="7 0 0 0" />
                    </Grid>
                  </media:MediaPlaylistRow>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Classes="media-empty" Text="{Binding QueueEmptyText}" FontSize="{Binding EmptyFontSize}"
                     Foreground="{Binding InactiveForegroundColor}" IsVisible="{Binding QueueEmpty}" />
      </Grid>
    </Border>
    <Button Grid.Column="2" Grid.Row="1" Classes="media-button" Command="{Binding PlaylistCommand}"
            Width="{Binding OverlayRowHeight}" Margin="{Binding OverlayRowGapMargin}">
      <media:MediaGlyph Kind="Playlist" GlyphColor="{Binding PlaylistColor}" />
    </Button>
  </Grid>
</UserControl>
