<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/ArthurGamerHD/AcruxUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:LcdMod.Client.Apps.Views"
    xmlns:sensors="using:LcdMod.Client.Apps.ExternalSensors"
    xmlns:controls="using:LcdMod.Client.Apps.Controls"
    x:Class="LcdMod.Client.Apps.ExternalSensors.ExternalSensorsView"
    x:DataType="sensors:ExternalSensorsViewModel"
    Design.DataContext="{x:Static sensors:ExternalSensorsViewModelPreview.Default}">
  <UserControl.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/Maps.xaml" />
  </UserControl.Styles>
  <Grid>
    <views:StatusMessageView DataContext="{Binding Message}" />
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Spacing="8">
      <ToggleButton Classes="map-button" IsChecked="{Binding IsFirstPersonView}" Command="{Binding ViewCommand}"
                    ToolTip.Tip="{Binding ViewTip}" ToolTip.Placement="Left">
        <Border Classes="map-icon" OpacityMask="{Binding ViewIcon}" />
      </ToggleButton>
      <ToggleButton Classes="map-button" IsChecked="{Binding IsCameraLocked}" Command="{Binding CameraLockCommand}"
                    ToolTip.Tip="{Binding CameraLockTip}" ToolTip.Placement="Left">
        <Border Classes="map-icon" OpacityMask="{Binding CameraLockIcon}" />
      </ToggleButton>
    </StackPanel>
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSceneLoading}">
        <controls:LoadingWheel Width="16" Height="16" VerticalAlignment="Center" />
        <TextBlock Text="{Binding SceneLoadingText}" FontFamily="{DynamicResource textFont}"
                   FontSize="0.6" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
