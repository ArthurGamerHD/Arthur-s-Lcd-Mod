<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/ArthurGamerHD/AcruxUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:market="using:LcdMod.Client.Apps.NpcMarket"
        xmlns:ext="using:LcdMod.Client.Apps.Views.Extensions"
        x:Class="LcdMod.Client.Apps.NpcMarket.MarketItemDialogView"
        x:DataType="market:MarketItemDialogViewModel"
        Design.DataContext="{x:Static market:MarketItemDialogViewModelPreview.Default}"
        Title="{Binding Title}" Width="640" Height="460" MinWidth="360" MinHeight="280"
        Padding="14 4 14 14">
  <Window.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Toolkit/Dialogs.xaml" />
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="Auto,*,Auto,8,160" Margin="0 0 0 10">
      <Image Source="{Binding Icon}" Width="40" Height="40" />
      <Button Grid.Column="2" Classes="dialog-button" Height="34" Command="{Binding OpenCartCommand}" IsVisible="{Binding ShowCart}">
        <TextBlock Classes="dialog-text" Text="{Binding CartLabel}" FontSize="{Binding FontSize}" />
      </Button>
      <Border x:Name="ModeHost" Grid.Column="4" Height="34" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="80,*,120,90" Height="30" Margin="4 0 14 4">
      <Button Classes="dialog-header" Command="{Binding SortDistanceCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
          <TextBlock Classes="dialog-text" Text="{Binding DistanceLabel}" FontSize="{Binding SmallFontSize}" />
          <Image Source="Triangle" Width="8" Height="6" IsVisible="{Binding IsDistanceSorted}" RenderTransform="{Binding SortDirection}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Classes="dialog-header" Command="{Binding SortStationCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
          <TextBlock Classes="dialog-text" Text="{Binding StationLabel}" FontSize="{Binding SmallFontSize}" />
          <Image Source="Triangle" Width="8" Height="6" IsVisible="{Binding IsStationSorted}" RenderTransform="{Binding SortDirection}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="dialog-header" Command="{Binding SortPriceCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
          <TextBlock Classes="dialog-text" Text="{Binding PriceLabel}" FontSize="{Binding SmallFontSize}" />
          <Image Source="Triangle" Width="8" Height="6" IsVisible="{Binding IsPriceSorted}" RenderTransform="{Binding SortDirection}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="dialog-header" Command="{Binding SortTrendCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
          <TextBlock Classes="dialog-text" Text="{Binding TrendLabel}" FontSize="{Binding SmallFontSize}" />
          <Image Source="Triangle" Width="8" Height="6" IsVisible="{Binding IsTrendSorted}" RenderTransform="{Binding SortDirection}" />
        </StackPanel>
      </Button>
    </Grid>
    <Border Grid.Row="2" Classes="dialog-panel">
      <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="market:MarketQuoteRow">
                <Button Margin="0 0 0 2" Classes="dialog-row" Command="{Binding Command}" Height="32" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="80,*,120,90">
                    <Border Margin="-6 -3" Width="4" HorizontalAlignment="Left" CornerRadius="2"
                            Background="{DynamicResource accentColor}" IsVisible="{Binding IsSelected}" />
                    <TextBlock Classes="dialog-text" Text="{Binding Distance}" FontSize="{Binding FontSize}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="dialog-text" Text="{Binding Station}" FontSize="{Binding FontSize}" Margin="10 0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="dialog-text" Text="{Binding Price}" FontSize="{Binding FontSize}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Image Source="{Binding TrendIcon}" Width="14" Height="14" RenderTransform="{Binding TrendRotation}" />
                      <TextBlock Classes="dialog-text" Text="{Binding Trend}" FontSize="{Binding FontSize}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Classes="dialog-muted" Text="{Binding EmptyText}" FontSize="{Binding FontSize}" IsVisible="{Binding IsEmpty}" />
      </Grid>
    </Border>
    <Border Grid.Row="3" Classes="dialog-panel" Margin="0 10 0 0" Padding="10 8" IsVisible="{Binding ShowDelivery}">
      <Grid ColumnDefinitions="*,8,*,8,Auto" RowDefinitions="Auto,Auto,6,Auto">
        <TextBlock Grid.ColumnSpan="5" Margin="0 0 0 6" Classes="dialog-text" Foreground="{DynamicResource errorColor}"
                   Text="{Binding ErrorText}" FontSize="{Binding SmallFontSize}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
        <TextBlock Grid.ColumnSpan="5" Margin="0 0 0 6" Classes="dialog-text" Foreground="{DynamicResource accentColor}"
                   Text="{Binding InfoText}" FontSize="{Binding SmallFontSize}" TextWrapping="Wrap" IsVisible="{Binding HasInfo}" />
        <TextBlock Grid.Row="1"  Classes="dialog-text" Text="{Binding PriceText}" FontSize="{Binding LargeFontSize}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ComboBox x:Name="Destination" Grid.Row="3" Grid.Column="2" ItemsSource="{Binding Destinations}"
                  SelectedIndex="{Binding SelectedDestinationIndex, Mode=TwoWay}"
                  PlaceholderText="{ext:loc LcdMod_Market_Delivery_Destination}" HorizontalAlignment="Stretch" Height="34" Margin="0" />
        <Button Grid.Row="1" Grid.Column="4" Classes="dialog-button" HorizontalAlignment="Stretch"
                Command="{Binding AddToCartCommand}" IsEnabled="{Binding CanAddToCart}">
          <TextBlock Classes="dialog-text" Text="{ext:loc LcdMod_Market_Delivery_Button_AddToCart}" FontSize="{Binding FontSize}" />
        </Button>
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding DeliveryQuantity, Mode=TwoWay}" MaxLength="4" Height="34" />
        <TextBlock Grid.Row="3" Classes="dialog-text" Text="{Binding DeliveryText}" FontSize="{Binding SmallFontSize}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button Grid.Row="3" Grid.Column="4" Classes="dialog-button primary" HorizontalAlignment="Stretch"
                Command="{Binding BuyCommand}" IsEnabled="{Binding CanOrder}" PointerEntered="OnBuyNowEntered">
          <TextBlock Classes="dialog-text" Text="{ext:loc LcdMod_Market_Delivery_Button_BuyNow}" FontSize="{Binding FontSize}" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
