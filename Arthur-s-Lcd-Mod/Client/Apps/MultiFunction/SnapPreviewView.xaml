<?xml version="1.0" encoding="utf-8"?>
<!-- Where a dragged window will snap when it is released here. -->
<Window
    xmlns="https://github.com/ArthurGamerHD/AcruxUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="LcdMod.Client.Apps.MultiFunction.SnapPreviewView"
    Classes="mfd-snap-preview"
    WindowDecorations="None"
    Topmost="True"
    CanResize="False"
    CanMinimize="False"
    CanMaximize="False">
  <Window.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/MultiFunction.xaml" />
  </Window.Styles>
  <Border Classes="mfd-snap" />
</Window>
