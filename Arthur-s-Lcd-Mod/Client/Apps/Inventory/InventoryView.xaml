<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/ArthurGamerHD/AcruxUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:inventory="using:LcdMod.Client.Apps.Inventory"
    x:Class="LcdMod.Client.Apps.Inventory.InventoryView"
    x:DataType="LcdMod.Client.Apps.Inventory.InventoryViewModel"
    Design.DataContext="{x:Static inventory:InventoryViewModelPreview.Default}"
    Layout="{Binding Layout}"
    Classes="{Binding Layout, Converter={StaticResource EnumClass}}">
  <UserControl.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/Inventory.xaml" />
    <!-- The display mode (the view's class) picks each item's template. -->
    <Style Selector="UserControl.card inventory|InventoryItemControl">
      <Setter Property="Tiles" Value="True" />
      <Setter Property="Cards" Value="True" />
    </Style>
    <Style Selector="UserControl.grid inventory|InventoryItemControl">
      <Setter Property="Tiles" Value="True" />
    </Style>
    <Style Selector="UserControl.table inventory|InventoryItemControl">
      <Setter Property="Table" Value="True" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Grid x:Name="Header">
      <inventory:InventorySortHeader x:Name="NameSort" Caption="{Binding NameHeader}"
          Active="{Binding SortByName}" Descending="{Binding SortDescending}"
          Command="{Binding NameSortCommand}" />
      <inventory:InventorySortHeader x:Name="AmountSort" Caption="{Binding AmountHeader}"
          Active="{Binding SortByAmount}" Descending="{Binding SortDescending}"
          HorizontalAlignment="Right" IsAmount="True"
          Command="{Binding AmountSortCommand}" />
      <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource dividerColor}" />
    </Grid>
    <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ItemList" ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="inventory:InventoryItemModel">
            <inventory:InventoryItemControl ItemIcon="{Binding Icon}" ItemName="{Binding Name}"
                Amount="{Binding Amount}" Status="{Binding Status}" Command="{Binding Command}"
                Odd="{Binding Odd}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
