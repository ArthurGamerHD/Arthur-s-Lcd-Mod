<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/ArthurGamerHD/AcruxUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cargo="using:LcdMod.Client.Apps.CargoFilled"
    xmlns:controls="using:LcdMod.Client.Apps.Controls"
    xmlns:views="using:LcdMod.Client.Apps.Views"
    x:Class="LcdMod.Client.Apps.CargoFilled.CargoFilledView"
    x:DataType="LcdMod.Client.Apps.CargoFilled.CargoFilledViewModel"
    Design.DataContext="{x:Static cargo:CargoFilledViewModelPreview.Default}"
    CardHeight="{Binding CardHeight}">
  <UserControl.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/Cards.xaml" />
  </UserControl.Styles>
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding Columns}" VerticalAlignment="Top" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="LcdMod.Client.Apps.CargoFilled.CargoPercentageEntry">
            <controls:BlockPropertyPercentage Classes="{Binding Classes}" Fill="{Binding Fill}" ItemIcon="{Binding Icon}"
                                              Label="{Binding Name}"
                                              Value="{Binding Percentage}"
                                              ValueText="{Binding PercentageText}"
                                              Command="{Binding Command}" Cursor="Hand" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <views:StatusMessageView DataContext="{Binding Message}" />
  </Grid>
</UserControl>
