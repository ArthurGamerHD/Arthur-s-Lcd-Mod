<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/ArthurGamerHD/Adk"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:LcdMod.Client.Apps.Dialogs"
        xmlns:ext="using:LcdMod.Client.Apps.Views.Extensions"
        x:Class="LcdMod.Client.Apps.Dialogs.SpritePickerView"
        x:DataType="dialogs:SpritePickerViewModel"
        Title="{ext:loc LcdMod_SpritePicker_Title}" Width="440" Height="460" MinWidth="320" MinHeight="260"
        Padding="14 4 14 14">
  <Window.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/Dialogs.xaml" />
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBox Classes="clearButton" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{ext:loc LcdMod_SpritePicker_SearchPlaceholder}"
             Height="36" Margin="0 0 0 8">
      <TextBox.InnerLeftContent>
        <Border Classes="search-icon">
          <Border.OpacityMask>
            <ImageBrush Source="Search" Stretch="Uniform" />
          </Border.OpacityMask>
        </Border>
      </TextBox.InnerLeftContent>
    </TextBox>
    <Border Grid.Row="1" Classes="dialog-panel">
      <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Sprites}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dialogs:SpriteRow">
                <Button Margin="0 0 0 3" Classes="{Binding Classes}" Command="{Binding Command}" Height="40">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="dialog-icon" Width="34" Height="34" Margin="0 0 10 0">
                      <Image Source="{Binding Name}" Width="32" Height="32" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="dialog-text" Text="{Binding Name}"
                               FontSize="{Binding FontSize}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Classes="dialog-muted" Text="{Binding EmptyText}" FontSize="{Binding FontSize}"
                   IsVisible="{Binding IsEmpty}" />
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0 10 0 0" IsVisible="{Binding AllowMultiple}">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="dialog-text" Text="{Binding SelectionText}" FontSize="{Binding FontSize}" />
        <TextBlock Classes="dialog-muted" Text="{ext:loc LcdMod_SpritePicker_MultiSelectHint}" FontSize="{Binding SmallFontSize}"
                   HorizontalAlignment="Left" />
      </StackPanel>
      <Button Grid.Column="1" Classes="dialog-button primary" Command="{Binding ApplyCommand}">
        <TextBlock Classes="dialog-text" Text="{ext:loc LcdMod_Common_Button_Apply}" FontSize="{Binding FontSize}" />
      </Button>
    </Grid>
  </Grid>
</Window>
