<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/ArthurGamerHD/Adk"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:LcdMod.Client.Apps.Dialogs"
        xmlns:ext="using:LcdMod.Client.Apps.Views.Extensions"
        x:Class="LcdMod.Client.Apps.Dialogs.FilePickerView"
        x:DataType="dialogs:FilePickerViewModel"
        Title="{Binding Title}" Width="460" Height="460" MinWidth="340" MinHeight="270"
        Padding="14 4 14 14">
  <Window.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/Dialogs.xaml" />
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0 0 0 8">
      <Button Classes="dialog-close" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}">
        <Image Source="LeftArrow" Width="16" Height="16" />
      </Button>
      <Button Grid.Column="1" Classes="dialog-close" Margin="6 0" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}">
        <Image Source="RightArrow" Width="16" Height="16" />
      </Button>
      <TextBlock Grid.Column="2" Classes="dialog-text" Text="{Binding PathText}" FontSize="{Binding SmallFontSize}" VerticalAlignment="Center" />
    </Grid>
    <TextBox Grid.Row="1" Classes="clearButton" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{ext:loc LcdMod_FilePicker_SearchPlaceholder}"
             Height="36" Margin="0 0 0 8">
      <TextBox.InnerLeftContent>
        <Border Classes="search-icon">
          <Border.OpacityMask>
            <ImageBrush Source="Search" Stretch="Uniform" />
          </Border.OpacityMask>
        </Border>
      </TextBox.InnerLeftContent>
    </TextBox>
    <Border Grid.Row="2" Classes="dialog-panel">
      <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsBrowsing}">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dialogs:FileRow">
                <Button Margin="0 0 0 3" Classes="{Binding Classes}" Command="{Binding Command}" Height="42">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="dialog-icon" Width="32" Height="32" Margin="0 0 10 0">
                      <Image Source="{Binding Icon}" Width="28" Height="28" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="dialog-text" Text="{Binding Name}" FontSize="{Binding FontSize}" />
                      <TextBlock Classes="dialog-muted" Text="{Binding Subtitle}" FontSize="{Binding SmallFontSize}"
                                 HorizontalAlignment="Left" IsVisible="{Binding HasSubtitle}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Classes="dialog-muted" Text="{Binding EmptyText}" FontSize="{Binding FontSize}" IsVisible="{Binding IsEmpty}" />
        <TextBlock Classes="dialog-muted" Text="{Binding LoadingText}" FontSize="{Binding FontSize}" IsVisible="{Binding IsLoading}" />
      </Grid>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0 10 0 0">
      <ItemsControl ItemsSource="{Binding Actions}" IsVisible="{Binding HasActions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="6" LineSpacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="dialogs:FileActionRow">
            <Button Classes="{Binding Classes}" Command="{Binding Command}" IsEnabled="{Binding IsEnabled}">
              <TextBlock Classes="dialog-text" Text="{Binding Text}" FontSize="{Binding FontSize}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Grid.Column="1" Classes="dialog-button primary" Margin="8 0 0 0" Command="{Binding SelectCommand}" IsEnabled="{Binding CanSelect}">
        <TextBlock Classes="dialog-text" Text="{Binding SelectText}" FontSize="{Binding FontSize}" />
      </Button>
    </Grid>
  </Grid>
</Window>
