<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/ArthurGamerHD/AcruxUI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pictures="using:LcdMod.Client.Apps.DigitalPictureFrames"
             xmlns:controls="using:LcdMod.Client.Apps.Controls"
             x:Class="LcdMod.Client.Apps.DigitalPictureFrames.DigitalPictureFramesView"
             x:DataType="pictures:DigitalPictureFramesViewModel"
             Design.DataContext="{x:Static pictures:DigitalPictureFramesViewModelPreview.Default}">
  <UserControl.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/DigitalPictureFrames.xaml" />
  </UserControl.Styles>
  <Grid>
    <Carousel ItemsSource="{Binding Pages}" SelectedIndex="{Binding SelectedPage}" WrapSelection="True"
              IsVisible="{Binding HasImage}">
      <Carousel.ItemTemplate>
        <DataTemplate x:DataType="pictures:PicturePage">
          <Grid Background="{Binding Image}">
            <controls:LoadingWheel Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsLoading}" />
          </Grid>
        </DataTemplate>
      </Carousel.ItemTemplate>
    </Carousel>
    <Button Classes="picture-overlay"
            Command="{Binding OpenPickerCommand}"
            IsEnabled="{Binding CanEdit}"
            IsVisible="{Binding HasImage}" />
    <Button Content="{Binding PickText}"
            Command="{Binding OpenPickerCommand}"
            IsEnabled="{Binding CanEdit}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinWidth="220"
            IsVisible="{Binding ShowPickerButton}" />
  </Grid>
</UserControl>
