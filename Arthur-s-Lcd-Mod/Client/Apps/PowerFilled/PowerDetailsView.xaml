<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/ArthurGamerHD/AcruxUI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:power="using:LcdMod.Client.Apps.PowerFilled"
             x:Class="LcdMod.Client.Apps.PowerFilled.PowerDetailsView"
             x:DataType="power:PowerDisplayEntry"
             Design.DataContext="{x:Static power:PowerDisplayEntryPreview.Default}">
  <StackPanel Classes="power-details-body">
    <Grid ColumnDefinitions="Auto,*">
      <Image Classes="power-details-icon" Source="{Binding Icon}" />
      <TextBlock Grid.Column="1" Classes="power-details-title" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
    </Grid>
    <ItemsControl ItemsSource="{Binding Details}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="power:PowerDetailModel">
          <Grid>
            <TextBlock Classes="power-details-line" Text="{Binding Text}" IsVisible="{Binding IsText}" />
            <Button Classes="hyperlink power-details-action" Command="{Binding Command}" IsEnabled="{Binding CanClick}"
                    IsVisible="{Binding IsAction}">
              <TextBlock Classes="power-details-link" Text="{Binding Text}" />
            </Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
