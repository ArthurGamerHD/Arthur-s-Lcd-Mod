<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/ArthurGamerHD/AcruxUI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LcdMod.Client.Apps.Controls"
             xmlns:power="using:LcdMod.Client.Apps.PowerFilled"
             x:Class="LcdMod.Client.Apps.PowerFilled.PowerFilledView"
             x:DataType="LcdMod.Client.Apps.PowerFilled.PowerFilledViewModel"
             Design.DataContext="{x:Static power:PowerFilledViewModelPreview.Default}"
    CardHeight="{Binding CardHeight}">
  <UserControl.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/Cards.xaml" />
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/PowerFillGauge.xaml" />
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/PowerDetails.xaml" />
  </UserControl.Styles>
  <Grid RowDefinitions="* Auto">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <ItemsControl ItemsSource="{Binding CompactEntries}" IsVisible="{Binding IsCompact}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding Columns}" VerticalAlignment="Top" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="LcdMod.Client.Apps.PowerFilled.PowerDisplayEntry">
              <power:PowerDetailsButton Classes="power-details-button" HasDetails="{Binding HasDetails}">
                <Grid Classes="power-fill-card" RowDefinitions="78* 22*" ColumnDefinitions="2* 6* 2*">
                  <power:PowerFillGauge Classes="{Binding FillClass}" Value="{Binding Percentage}"
                                        FillColor="{Binding FillColor}" Foreground="{Binding Foreground}"
                                        ShowCenterIcon="{Binding DrawCenterIcon}"
                                        CenterIconRotation="{Binding CenterIconRotation}" Grid.ColumnSpan="3" />
                  <controls:FitTextBlock Classes="power-fill-label" Text="{Binding PercentText}" Foreground="{Binding Foreground}"
                                         Grid.Row="1" Grid.Column="1" />
                </Grid>
              </power:PowerDetailsButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding CardEntries}" IsVisible="{Binding IsCard}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding Columns}" VerticalAlignment="Top" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="LcdMod.Client.Apps.PowerFilled.PowerDisplayEntry">
              <power:PowerDetailsButton Classes="power-details-button" HasDetails="{Binding HasDetails}">
                <controls:BlockPropertyPercentage Classes="card" ItemIcon="{Binding Icon}" Label="{Binding Label}"
                                                  Value="{Binding Percentage}" ValueText="{Binding PercentText}" />
              </power:PowerDetailsButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="1" Classes="power-footer" IsVisible="{Binding HasFooter}">
      <ItemsControl ItemsSource="{Binding FooterRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="LcdMod.Client.Apps.PowerFilled.PowerFooterRow">
            <Grid Classes="power-footer-row" Height="{Binding Height}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <power:PowerFillGauge Width="{Binding IconSize}" Height="{Binding IconSize}"
                                      Classes="{Binding FillClass}" Value="{Binding Ratio}"
                                      FillColor="{Binding StatusColor}" Foreground="{Binding Foreground}"
                                      ShowCenterIcon="{Binding DrawCenterIcon}" />
                <TextBlock Classes="power-footer-text" Text="{Binding ChargeText}" Margin="{Binding TextMargin}"
                           FontSize="{Binding FontSize}" Foreground="{Binding Foreground}" />
              </StackPanel>
              <TextBlock Classes="power-footer-text" Text="{Binding StatusText}" HorizontalAlignment="Center"
                         FontSize="{Binding FontSize}" Foreground="{Binding StatusColor}" />
              <TextBlock Classes="power-footer-text" Text="{Binding RightText}" HorizontalAlignment="Right"
                         FontSize="{Binding FontSize}" Foreground="{Binding RightColor}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </Grid>
</UserControl>
