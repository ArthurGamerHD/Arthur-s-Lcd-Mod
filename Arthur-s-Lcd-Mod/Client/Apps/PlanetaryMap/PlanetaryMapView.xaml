<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/ArthurGamerHD/Adk"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maps="using:LcdMod.Client.Apps.Maps"
    xmlns:planetary="using:LcdMod.Client.Apps.PlanetaryMap"
    xmlns:ext="using:LcdMod.Client.Apps.Views.Extensions"
    x:Class="LcdMod.Client.Apps.PlanetaryMap.PlanetaryMapView"
    x:DataType="planetary:PlanetaryMapViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/Maps.xaml" />
  </UserControl.Styles>
  <Grid>
    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" IsVisible="{Binding HasStatus}"
               FontFamily="{DynamicResource textFont}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
               Margin="12 0 12 64" TextWrapping="Wrap" TextAlignment="Center" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Spacing="8">
      <maps:StreetViewHandle Classes="map-street-view" Width="42" Height="42" IsAvailable="{Binding StreetViewAvailable}"
                             ToolTip.Tip="{Binding StreetViewTip}" ToolTip.Placement="Top"
                             Foreground="{DynamicResource accentColor}" DisabledForeground="{DynamicResource disabledColor}" />
      <ItemsControl ItemsSource="{Binding Layers}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="maps:MapLayerItem">
            <Button Classes="map-layer" Command="{Binding Command}" IsVisible="{Binding IsShown}"
                    ToolTip.Tip="{Binding Tip}" ToolTip.Placement="Top">
              <Grid>
                <maps:LayerPreview Cubemap="{Binding Cubemap}" Face="{Binding Face}"
                                   Placeholder="{DynamicResource surfaceContainerHighestColor}" />
                <Border Classes="map-layer-selection" IsVisible="{Binding IsSelected}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ToggleButton Classes="map-button" IsVisible="{Binding WaterVisible}" IsEnabled="{Binding WaterEnabled}"
                    IsChecked="{Binding IsWaterHidden}" Command="{Binding WaterCommand}"
                    ToolTip.Tip="{ext:loc LcdMod_PlanetaryMap_Water_Title}" ToolTip.Placement="Top">
        <Border Classes="map-icon" OpacityMask="{Binding WaterIcon}" />
      </ToggleButton>
    </StackPanel>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Spacing="8">
      <ToggleButton Classes="map-button" IsChecked="{Binding IsNorthLocked}" Command="{Binding OrientationCommand}"
                    ToolTip.Tip="{Binding OrientationTip}" ToolTip.Placement="Left">
        <Border Classes="map-icon" OpacityMask="{Binding CompassIcon}"
                RenderTransform="{Binding OrientationTransform}" />
      </ToggleButton>
      <ToggleButton Classes="map-button" IsChecked="{Binding IsFollowing}" Command="{Binding FollowCommand}"
                    ToolTip.Tip="{Binding FollowTip}" ToolTip.Placement="Left">
        <Border Classes="map-icon" OpacityMask="{Binding FollowIcon}" />
      </ToggleButton>
    </StackPanel>
  </Grid>
</UserControl>
