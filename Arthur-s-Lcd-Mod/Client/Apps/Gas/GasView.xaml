<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/ArthurGamerHD/Adk"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LcdMod.Client.Apps.Controls"
    x:Class="LcdMod.Client.Apps.Gas.GasView"
    x:DataType="LcdMod.Client.Apps.Gas.GasViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Data/Gui/Styles/Fluent/Controls/Cards.xaml" />
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Entries}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="{Binding Columns}" VerticalAlignment="Top" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="LcdMod.Client.Apps.Gas.GasDisplayEntry">
          <controls:BlockPropertyPercentage Classes="{Binding Classes}" Fill="{Binding Fill}" ItemIcon="{Binding Icon}"
                                            Label="{Binding Name}"
                                            Value="{Binding Percentage}"
                                            ValueText="{Binding PercentageText}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
