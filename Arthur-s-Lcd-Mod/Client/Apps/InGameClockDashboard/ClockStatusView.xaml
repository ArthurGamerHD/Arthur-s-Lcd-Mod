<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/ArthurGamerHD/Adk"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:clock="using:LcdMod.Client.Apps.InGameClockDashboard"
             xmlns:controls="using:LcdMod.Client.Apps.Controls"
             x:Class="LcdMod.Client.Apps.InGameClockDashboard.ClockStatusView"
             x:DataType="clock:InGameClockDashboardViewModel">
  <Grid>
    <Grid ColumnDefinitions="* * *" RowDefinitions="* *" IsVisible="{Binding IsNotTiny}">
      <clock:ClockForecastView Grid.RowSpan="2" />
      <Grid Grid.Column="1" ColumnDefinitions="24* 76*">
        <controls:SpriteIcon Source="{Binding MomentIcon}" SizeRatio="{Binding MetricIconRatio}" />
        <TextBlock Grid.Column="1" Classes="clock-text" Text="{Binding Moment}" FontSize="{Binding StatusFontSize}" Margin="{Binding MetricTextMargin}" />
      </Grid>
      <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="24* 76*">
        <controls:SpriteIcon Source="WeatherHeavyWind" SizeRatio="{Binding MetricIconRatio}" />
        <TextBlock Grid.Column="1" Classes="clock-text" Text="{Binding Wind}" FontSize="{Binding StatusFontSize}" Margin="{Binding MetricTextMargin}" />
      </Grid>
      <Grid Grid.Column="2" ColumnDefinitions="66* 34*">
        <TextBlock Classes="clock-text" Text="{Binding Sunrise}" FontSize="{Binding TrailingFontSize}" TextAlignment="Right" Margin="{Binding TrailingTextMargin}" />
        <controls:SpriteIcon Grid.Column="1" Source="WeatherSunRise" SizeRatio="{Binding TrailingIconRatio}" />
      </Grid>
      <Grid Grid.Column="2" Grid.Row="1" ColumnDefinitions="66* 34*">
        <TextBlock Classes="clock-text" Text="{Binding Sunset}" FontSize="{Binding TrailingFontSize}" TextAlignment="Right" Margin="{Binding TrailingTextMargin}" />
        <controls:SpriteIcon Grid.Column="1" Source="WeatherSunSet" SizeRatio="{Binding TrailingIconRatio}" />
      </Grid>
    </Grid>
    <Grid ColumnDefinitions="* *" RowDefinitions="* *" IsVisible="{Binding IsTiny}">
      <Grid ColumnDefinitions="24* 76*">
        <controls:SpriteIcon Source="{Binding MomentIcon}" SizeRatio="{Binding MetricIconRatio}" />
        <TextBlock Grid.Column="1" Classes="clock-text" Text="{Binding Moment}" FontSize="{Binding StatusFontSize}" Margin="{Binding MetricTextMargin}" />
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="24* 76*">
        <controls:SpriteIcon Source="WeatherHeavyWind" SizeRatio="{Binding MetricIconRatio}" />
        <TextBlock Grid.Column="1" Classes="clock-text" Text="{Binding Wind}" FontSize="{Binding StatusFontSize}" Margin="{Binding MetricTextMargin}" />
      </Grid>
      <Grid Grid.Column="1" ColumnDefinitions="66* 34*">
        <TextBlock Classes="clock-text" Text="{Binding Sunrise}" FontSize="{Binding TrailingFontSize}" TextAlignment="Right" Margin="{Binding TrailingTextMargin}" />
        <controls:SpriteIcon Grid.Column="1" Source="WeatherSunRise" SizeRatio="{Binding TrailingIconRatio}" />
      </Grid>
      <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="66* 34*">
        <TextBlock Classes="clock-text" Text="{Binding Sunset}" FontSize="{Binding TrailingFontSize}" TextAlignment="Right" Margin="{Binding TrailingTextMargin}" />
        <controls:SpriteIcon Grid.Column="1" Source="WeatherSunSet" SizeRatio="{Binding TrailingIconRatio}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
