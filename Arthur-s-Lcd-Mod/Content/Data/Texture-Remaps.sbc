        </LCDTextureDefinition>

        <LCDTextureDefinition> <!-- Remap of Vanilla Economy trend decrease sprite -->
            <Id Type="LCDTextureDefinition" Subtype="ArrowGreenDown"/>
            <SpritePath>Textures/GUI/Contracts/ArrowGreenDown.png</SpritePath>
            <Selectable>false</Selectable>
        </LCDTextureDefinition>

        <LCDTextureDefinition> <!-- Remap of Vanilla Economy trend increase sprite -->
            <Id Type="LCDTextureDefinition" Subtype="ArrowRedUp"/>
            <SpritePath>Textures/GUI/Contracts/ArrowRedUp.png</SpritePath>
