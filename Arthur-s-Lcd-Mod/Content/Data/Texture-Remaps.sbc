        <LCDTextureDefinition> <!-- Remap of Vanilla left arrow control sprite -->
            <Id Type="LCDTextureDefinition" Subtype="LeftArrow"/>
            <SpritePath>Textures/GUI/Controls/LeftArrow_highlight.dds</SpritePath>
