<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/AcruxUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:thrust="using:LcdMod.Client.Apps.Thrust">
  <Style Selector="thrust|ThrustTelemetryControl">
    <Setter Property="FontSize" Value="{DynamicResource fontScale}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Width="{TemplateBinding BoxWidth}" Height="{TemplateBinding BoxHeight}"
                Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{TemplateBinding Value}" FontFamily="{TemplateBinding FontFamily}"
                     FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                     Margin="{TemplateBinding TextMargin}" TextAlignment="Right" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
