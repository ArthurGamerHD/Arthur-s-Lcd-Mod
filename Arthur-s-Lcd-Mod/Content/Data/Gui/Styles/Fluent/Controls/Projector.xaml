<Styles xmlns="https://github.com/ArthurGamerHD/AcruxUI">
  <StyleInclude Source="./MultiProgressPanel.xaml" />
  <Style Selector="Border.projector-footer">
    <Setter Property="Background" Value="{DynamicResource panelBackground}" />
    <Setter Property="Padding" Value="6,8,6,0" />
  </Style>
  <Style Selector="Button.projector-action">
    <Setter Property="Background" Value="{DynamicResource accentContainerColor}" />
    <Setter Property="Foreground" Value="{DynamicResource onAccentContainerColor}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.projector-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighColor}" />
    <Setter Property="Foreground" Value="{DynamicResource onSurfaceColor}" />
  </Style>
  <Style Selector="Button.projector-action:pressed">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighestColor}" />
    <Setter Property="Foreground" Value="{DynamicResource onSurfaceColor}" />
  </Style>
  <Style Selector="Button.projector-action:disabled">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerLowColor}" />
    <Setter Property="Foreground" Value="{DynamicResource disabledColor}" />
  </Style>
  <Style Selector="TextBlock.projector-action-label">
    <Setter Property="FontSize" Value="{DynamicResource projectorButtonFontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="Foreground" Value="{DynamicResource onAccentContainerColor}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.projector-action:pointerover TextBlock.projector-action-label">
    <Setter Property="Foreground" Value="{DynamicResource onSurfaceColor}" />
  </Style>
  <Style Selector="Button.projector-action:pressed TextBlock.projector-action-label">
    <Setter Property="Foreground" Value="{DynamicResource onSurfaceColor}" />
  </Style>
  <Style Selector="Button.projector-action:disabled TextBlock.projector-action-label">
    <Setter Property="Foreground" Value="{DynamicResource disabledColor}" />
  </Style>
</Styles>
