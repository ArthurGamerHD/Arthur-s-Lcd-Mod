<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/AcruxUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:media="using:LcdMod.Client.Apps.MediaPlayer">
  <Style Selector="TextBlock.media-path">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.media-subtitle">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.media-caption">
    <Setter Property="Background" Value="#C0000000" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="MenuItem StackPanel.menu-dashes">
    <Setter Property="Spacing" Value="3" />
  </Style>
  <Style Selector="MenuItem Border.menu-dash">
    <Setter Property="Background" Value="{DynamicResource fontColor}" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="2" />
  </Style>
  <Style Selector="MenuItem Border.menu-square">
    <Setter Property="Background" Value="{DynamicResource fontColor}" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="media|MediaVolumeButton.media-button">
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="#00000000">
          <ContentPresenter Name="PART_ContentPresenter" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Border.media-volume-flyout">
    <Setter Property="Background" Value="#F0000000" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6 10" />
    <Setter Property="Margin" Value="0 0 0 6" />
  </Style>
  <Style Selector="Slider.media-volume-slider">
    <Setter Property="Width" Value="24" />
  </Style>
  <Style Selector="Border.media-dock">
    <Setter Property="Background" Value="#F0000000" />
  </Style>
  <Style Selector="Button.media-surface">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TextBlock.media-row-text">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.media-action-text">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.media-empty">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.media-button">
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="#00000000">
          <ContentPresenter Name="PART_ContentPresenter" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.media-action">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Name="PART_ContentPresenter" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="media|MediaPlaylistRow.media-row">
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="media|MediaPlaylistRow.media-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighColor}" />
  </Style>
  <Style Selector="media|MediaPlaylistRow.media-row:selected">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighestColor}" />
  </Style>
  <Style Selector="media|MediaPlaylistRow.media-row:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource accentColor}" />
  </Style>
</Styles>
