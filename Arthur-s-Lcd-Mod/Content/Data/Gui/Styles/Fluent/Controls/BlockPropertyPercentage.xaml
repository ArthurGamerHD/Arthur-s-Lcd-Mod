<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/Adk"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LcdMod.Client.Apps.Controls">
  <!-- Header-colored card shared by the percentage dashboards (Cargo, Gas, Power, Farm). -->
  <Style Selector="controls|BlockPropertyPercentage">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Classes="card-shadow" CornerRadius="{TemplateBinding CornerRadius}" Margin="2 2 0 0" />
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  Margin="0 0 2 2">
            <Grid ColumnDefinitions="Auto * Auto" RowDefinitions="* *">
              <Image Source="{TemplateBinding ItemIcon}" Width="40" Height="40" Margin="0 0 8 0" VerticalAlignment="Center" Grid.RowSpan="2" />
              <TextBlock Text="{TemplateBinding Label}" FontFamily="{TemplateBinding FontFamily}" Foreground="{TemplateBinding Foreground}"
                         FontSize="0.85" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         Grid.Column="1" Grid.ColumnSpan="2" />
              <ProgressBar Minimum="0" Maximum="1" Value="{TemplateBinding Value}"
                           Foreground="{TemplateBinding Fill}" Background="{TemplateBinding Track}"
                           Height="10" CornerRadius="5" Margin="0 4 8 0" VerticalAlignment="Center"
                           Grid.Column="1" Grid.Row="1" />
              <TextBlock Text="{TemplateBinding ValueText}" FontFamily="{TemplateBinding FontFamily}" Foreground="{TemplateBinding Foreground}"
                         FontSize="0.8" TextAlignment="Right" VerticalAlignment="Center"
                         Grid.Column="2" Grid.Row="1" />
            </Grid>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Default" />
    <Setter Property="Background" Value="{DynamicResource headerColor}" />
    <Setter Property="Foreground" Value="{DynamicResource fontColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource fontColor}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource cardFillColor}" />
    <Setter Property="Track" Value="{DynamicResource cardShadowColor}" />
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
  </Style>

  <!-- List mode: one line per entry. -->
  <Style Selector="controls|BlockPropertyPercentage.row">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Classes="card-shadow" CornerRadius="{TemplateBinding CornerRadius}" Margin="2 2 0 0" />
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  Margin="0 0 2 2">
            <Grid ColumnDefinitions="Auto 2* 3* Auto">
              <Image Source="{TemplateBinding ItemIcon}" Width="24" Height="24" Margin="0 0 6 0" VerticalAlignment="Center" />
              <TextBlock Text="{TemplateBinding Label}" FontFamily="{TemplateBinding FontFamily}" Foreground="{TemplateBinding Foreground}"
                         FontSize="0.75" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0 0 8 0"
                         Grid.Column="1" />
              <ProgressBar Minimum="0" Maximum="1" Value="{TemplateBinding Value}"
                           Foreground="{TemplateBinding Fill}" Background="{TemplateBinding Track}"
                           Height="8" CornerRadius="4" Margin="0 0 8 0" VerticalAlignment="Center"
                           Grid.Column="2" />
              <TextBlock Text="{TemplateBinding ValueText}" FontFamily="{TemplateBinding FontFamily}" Foreground="{TemplateBinding Foreground}"
                         FontSize="0.75" TextAlignment="Right" VerticalAlignment="Center"
                         Grid.Column="3" />
            </Grid>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6 4" />
  </Style>

  <!-- "Draw lines": outlined cells instead of filled cards. -->
  <Style Selector="controls|BlockPropertyPercentage.lines">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource headerColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Fill" Value="{DynamicResource accentColor}" />
    <Setter Property="Track" Value="{DynamicResource surfaceContainerHighestColor}" />
  </Style>

  <Style Selector="controls|BlockPropertyPercentage Border.card-shadow">
    <Setter Property="Background" Value="{DynamicResource cardShadowColor}" />
  </Style>
  <Style Selector="controls|BlockPropertyPercentage.lines Border.card-shadow">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Cards are buttons only so Cargo entries can be clicked; keep the card colors instead of Fluent's button states. -->
  <Style Selector="controls|BlockPropertyPercentage:pointerover">
    <Setter Property="Background" Value="{DynamicResource headerColor}" />
    <Setter Property="Foreground" Value="{DynamicResource fontColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource fontColor}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="controls|BlockPropertyPercentage:pressed">
    <Setter Property="Background" Value="{DynamicResource headerColor}" />
    <Setter Property="Foreground" Value="{DynamicResource fontColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource fontColor}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="controls|BlockPropertyPercentage.lines:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="controls|BlockPropertyPercentage.lines:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
