<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/Adk"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.hyperlink">
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="Foreground" Value="{DynamicResource fontColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource fontColor}" />
    <Setter Property="BorderThickness" Value="0 0 0 1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.hyperlink TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource fontColor}" />
  </Style>
  <Style Selector="Button.hyperlink:pointerover">
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="Foreground" Value="{DynamicResource onAccentColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource onAccentColor}" />
    <Setter Property="BorderThickness" Value="0 0 0 1" />
  </Style>
  <Style Selector="Button.hyperlink:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource onAccentColor}" />
  </Style>
  <Style Selector="Button.hyperlink:pressed">
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="Foreground" Value="{DynamicResource onAccentColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource onAccentColor}" />
    <Setter Property="BorderThickness" Value="0 0 0 1" />
  </Style>
  <Style Selector="Button.hyperlink:pressed TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource onAccentColor}" />
  </Style>
  <Style Selector="Button.hyperlink:focus-visible">
    <Setter Property="BorderThickness" Value="0 0 0 1" />
  </Style>
  <Style Selector="Button.hyperlink:disabled">
    <Setter Property="Foreground" Value="{DynamicResource disabledColor}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.hyperlink:disabled TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource disabledColor}" />
  </Style>
</Styles>
