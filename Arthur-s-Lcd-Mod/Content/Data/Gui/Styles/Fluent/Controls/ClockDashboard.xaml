<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/Adk"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LcdMod.Client.Apps.Controls">
  <Style Selector="Border.clock-card">
    <Setter Property="Background" Value="{DynamicResource accentContainerColor}" />
  </Style>
  <Style Selector="TextBlock.clock-text">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="Foreground" Value="{DynamicResource fontColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="controls|FitTextBlock.clock-fit">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="Foreground" Value="{DynamicResource fontColor}" />
  </Style>
  <Style Selector="controls|SpriteIcon.clock-tinted">
    <Setter Property="Tint" Value="{DynamicResource fontColor}" />
  </Style>
  <Style Selector="ProgressBar.clock-bar">
    <Setter Property="Background" Value="{DynamicResource surfaceColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
