<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/Adk">
  <Style Selector="Border.dialog-panel">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerColor}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="TextBlock.dialog-text">
    <Setter Property="Foreground" Value="{DynamicResource onSurfaceColor}" />
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
  </Style>
  <Style Selector="TextBlock.dialog-muted">
    <Setter Property="Foreground" Value="{DynamicResource onSurfaceVariantColor}" />
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.dialog-warning">
    <Setter Property="Foreground" Value="{DynamicResource errorColor}" />
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.dialog-close">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource surfaceContainerColor}" />
  </Style>
  <Style Selector="Button.dialog-button">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="10 4" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource accentContainerColor}" />
    <Setter Property="Foreground" Value="{DynamicResource onAccentContainerColor}" />
  </Style>
  <Style Selector="Button.primary TextBlock.dialog-text">
    <Setter Property="Foreground" Value="{DynamicResource onAccentContainerColor}" />
  </Style>
  <Style Selector="Button.dialog-row">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6 2" />
    <Setter Property="Background" Value="{DynamicResource secondaryContainerColor}" />
    <Setter Property="Foreground" Value="{DynamicResource onSecondaryContainerColor}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.dialog-row TextBlock.dialog-text">
    <Setter Property="Foreground" Value="{DynamicResource onSecondaryContainerColor}" />
  </Style>
  <Style Selector="Button.dialog-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighColor}" />
  </Style>
  <Style Selector="Button.dialog-row.selected">
    <Setter Property="Background" Value="{DynamicResource accentContainerColor}" />
    <Setter Property="Foreground" Value="{DynamicResource onAccentContainerColor}" />
  </Style>
  <Style Selector="Button.dialog-row.selected TextBlock.dialog-text">
    <Setter Property="Foreground" Value="{DynamicResource onAccentContainerColor}" />
  </Style>
  <Style Selector="Button.dialog-row.category">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighestColor}" />
  </Style>
  <Style Selector="Button.dialog-row.category.selected">
    <Setter Property="Background" Value="{DynamicResource accentContainerColor}" />
  </Style>
  <Style Selector="Border.dialog-icon">
    <Setter Property="Background" Value="#00000000" />
  </Style>
  <Style Selector="Button.dialog-header">
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4 0" />
  </Style>
  <Style Selector="Button.dialog-preview">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource surfaceContainerColor}" />
  </Style>
  <Style Selector="Button.dialog-choice">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource surfaceContainerLowColor}" />
  </Style>
  <Style Selector="Button.dialog-choice.selected">
    <Setter Property="Background" Value="{DynamicResource accentContainerColor}" />
    <Setter Property="Foreground" Value="{DynamicResource onAccentContainerColor}" />
  </Style>
  <Style Selector="Button.dialog-choice.selected TextBlock.dialog-text">
    <Setter Property="Foreground" Value="{DynamicResource onAccentContainerColor}" />
  </Style>
  <Style Selector="Button.craft-step">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.search-icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="0 0 8 0" />
    <Setter Property="Background" Value="{DynamicResource onSurfaceVariantColor}" />
  </Style>
  <Style Selector="TextBox.invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource errorColor}" />
  </Style>
  <!-- Last, so the shared button looks win over TextBlock.dialog-text above. -->
  <StyleInclude Source="./Buttons.xaml" />
</Styles>
