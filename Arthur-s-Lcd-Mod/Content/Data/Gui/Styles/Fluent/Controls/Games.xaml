<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/AcruxUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:games="using:LcdMod.Client.Games">
  <Style Selector="Button.game-region">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="#00000000" />
      </ControlTemplate>
    </Setter>
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.doom-keycap">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource borderVariantColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="2 1" />
    <Setter Property="MinWidth" Value="15" />
    <Setter Property="MinHeight" Value="15" />
  </Style>
  <Style Selector="TextBlock.doom-keycap-label">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="FontSize" Value="0.42" />
    <Setter Property="Foreground" Value="{DynamicResource onSurfaceColor}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.doom-tip-action">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="FontSize" Value="0.42" />
    <Setter Property="Foreground" Value="{DynamicResource fontColor}" />
  </Style>
  <Style Selector="games|GameMenuBar">
    <Setter Property="Background" Value="{DynamicResource accentColor}" />
  </Style>
  <Style Selector="games|GameMenuBar MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource accentContainerColor}" />
  </Style>
  <Style Selector="games|GameMenuBar MenuItem:pressed">
    <Setter Property="Background" Value="{DynamicResource accentContainerColor}" />
  </Style>
  <Style Selector="games|GameMenuBar MenuItem TextBlock.menu-header">
    <Setter Property="Foreground" Value="{DynamicResource onAccentColor}" />
  </Style>
</Styles>
