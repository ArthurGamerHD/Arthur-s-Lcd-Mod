<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/Adk"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.power-details-button">
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" />
      </ControlTemplate>
    </Setter>
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.power-details">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource borderVariantColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10 8" />
    <Setter Property="MaxWidth" Value="360" />
  </Style>
  <Style Selector="StackPanel.power-details-body">
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="Image.power-details-icon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="0 0 8 0" />
  </Style>
  <Style Selector="TextBlock.power-details-title">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="Foreground" Value="{DynamicResource accentColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.power-details-line">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="Foreground" Value="{DynamicResource onSurfaceColor}" />
    <Setter Property="FontSize" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.power-details-link">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="FontSize" Value="0.6" />
  </Style>
  <Style Selector="Button.power-details-action">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
</Styles>
