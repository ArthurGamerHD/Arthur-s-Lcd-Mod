<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/Adk"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="ItemDisplay">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="6">
          <Grid ColumnDefinitions="Auto * Auto"
                RowDefinitions="* *">
            <Image Source="{TemplateBinding ItemIcon}" Width="40" Height="40" Margin="0 0 8 0" VerticalAlignment="Center" Grid.RowSpan="2" />
            <TextBlock Text="{TemplateBinding Label}"
                       FontFamily="{TemplateBinding FontFamily}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="0.9"
                       Grid.Column="1"
                       Grid.RowSpan="2" />
            <TextBlock Text="{TemplateBinding PrimaryText}"
                       FontFamily="{TemplateBinding FontFamily}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="0.9"
                       TextAlignment="Right"
                       Grid.Column="2" />
            <TextBlock Text="{TemplateBinding SecondaryText}"
                       FontFamily="{TemplateBinding FontFamily}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="0.72"
                       TextAlignment="Right"
                       Grid.Column="2"
                       Grid.Row="1" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="Foreground" Value="{DynamicResource onSurfaceColor}" />
    <Setter Property="BorderBrush" Value="#00000000" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
  </Style>
  <Style Selector="ItemDisplay:card">
    <Setter Property="Background" Value="{DynamicResource accentContainerColor}" />
    <Setter Property="Foreground" Value="{DynamicResource onAccentContainerColor}" />
  </Style>
  <Style Selector="ItemDisplay:grid">
    <Setter Property="BorderBrush" Value="{DynamicResource surfaceColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ItemDisplay:warning">
    <Setter Property="Foreground" Value="{DynamicResource warningColor}" />
  </Style>
  <Style Selector="ItemDisplay:error">
    <Setter Property="Foreground" Value="{DynamicResource errorColor}" />
  </Style>
  <Style Selector="ItemDisplay:card:warning">
    <Setter Property="Background" Value="{DynamicResource warningColor}" />
    <Setter Property="Foreground" Value="{DynamicResource onAccentContainerColor}" />
  </Style>
  <Style Selector="ItemDisplay:card:error">
    <Setter Property="Background" Value="{DynamicResource errorColor}" />
    <Setter Property="Foreground" Value="{DynamicResource onAccentContainerColor}" />
  </Style>
</Styles>
