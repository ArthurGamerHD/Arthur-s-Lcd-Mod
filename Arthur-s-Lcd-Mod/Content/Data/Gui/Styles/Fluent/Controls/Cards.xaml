<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/AcruxUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LcdMod.Client.Apps.Controls">
  <Style Selector="controls|BlockPropertyPercentage.card">
    <Setter Property="Height" Value="{DynamicResource cardHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="3" />
  </Style>
  <Style Selector="controls|BlockPropertyPercentage.row">
    <Setter Property="Height" Value="{DynamicResource cardHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="3 2" />
  </Style>
  <Style Selector="controls|BlockPropertyPercentage.lines">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="controls|ItemDisplay.card">
    <Setter Property="Height" Value="{DynamicResource cardHeight}" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
</Styles>
