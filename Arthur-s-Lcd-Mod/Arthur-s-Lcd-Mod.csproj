<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netframework48</TargetFramework>
        <RootNamespace>LcdMod</RootNamespace>
        <LangVersion>6</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Configurations>Release;Debug;Experimetal</Configurations>
        <Platforms>x64</Platforms>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>TRACE;EXPERIMENTAL</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Experimetal'">
        <DefineConstants>TRACE;RELEASE;EXPERIMENTAL</DefineConstants>
        <Optimize>true</Optimize>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="2.1.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Mal.Mdk2.ModPackager" Version="2.2.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Mal.Mdk2.References" Version="2.2.8"/>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="Content\*\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AdditionalFiles>
        <AdditionalFiles Include="thumb.png" Condition="Exists('thumb.png')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AdditionalFiles>
        <AdditionalFiles Remove="Content\*\**\*.cs"/>
        <AdditionalFiles Remove="Content\Other content folders"/>
        <AdditionalFiles Remove="Content\Data\SBC files can go here"/>
        <AdditionalFiles Remove="Content\Data\SBC files can go here"/>
        <None Remove="thumb.jpg"/>
        <None Remove="thumb.png"/>

        <!-- why keen? why chinese language is not up to spec? ...  -->
        <AdditionalFiles Remove="Content\Data\Localization\MyTexts.zh.resx"/>
    </ItemGroup>

    <Target Name="MapzhTozhCN" BeforeTargets="PostBuildEvent">
        <Copy SourceFiles="$(MSBuildProjectDirectory)\Content\Data\Localization\MyTexts.zh.resx"
              DestinationFiles="$(MSBuildProjectDirectory)\Content\Data\Localization\MyTexts.zh-CN.resx"
              SkipUnchangedFiles="true"/>
    </Target>

    <Target Name="Mapjpgtopng" BeforeTargets="PostBuildEvent">
        <Copy SourceFiles="$(MSBuildProjectDirectory)\thumb.jpg"
              DestinationFiles="$(MSBuildProjectDirectory)\thumb.png"
              SkipUnchangedFiles="true"/>
    </Target>
    
    <ItemGroup>
        <ProjectReference Include="..\LcdModCodeGenerator\LcdModCodeGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>
    
    <ItemGroup>
      <EmbeddedResource Update="Content\Data\Localization\MyTexts.zh.resx">
        <DependentUpon>MyTexts.resx</DependentUpon>
      </EmbeddedResource>
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Client\Config\" />
      <Folder Include="Client\Terminal\" />
    </ItemGroup>

    <Target Name="RemoveZhCnResxAlias" AfterTargets="PostBuildEvent">
        <Delete Files="$(MSBuildProjectDirectory)\Content\Data\Localization\MyTexts.zh-CN.resx" />
    </Target>

    <Target Name="RemoveThumbAlias" AfterTargets="PostBuildEvent">
        <Delete Files="$(MSBuildProjectDirectory)\thumb.png" />
    </Target>
</Project>
