<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netframework48</TargetFramework>
        <RootNamespace>LcdMod</RootNamespace>
        <LangVersion>6</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Configurations>Release;Debug;Experimental</Configurations>
        <Platforms>x64</Platforms>
        <MdkInteractive>no</MdkInteractive>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>TRACE;EXPERIMENTAL</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Experimental'">
        <DefineConstants>TRACE;RELEASE;EXPERIMENTAL</DefineConstants>
        <Optimize>true</Optimize>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="9.0.0"
                          GeneratePathProperty="true">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>none</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Collections.Immutable" Version="9.0.0"
                          GeneratePathProperty="true">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>none</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <Analyzer Include="$(MdkSourceRoot)Mdk.ModAnalyzers/bin/$(MdkLocalPlatform)/$(MdkLocalConfiguration)/netstandard2.0/Mal.Mdk2.ModAnalyzers.dll"/>
    </ItemGroup>
    <Import Project="Mdk.LocalSource.targets"/>
    <ItemGroup>
        <AdditionalFiles Include="Content\*\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AdditionalFiles>
        <AdditionalFiles Include="readme.txt" Condition="Exists('readme.txt')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AdditionalFiles>
        <AdditionalFiles Include="thumb.png" Condition="Exists('thumb.png')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AdditionalFiles>
        <AdditionalFiles Remove="Content\*\**\*.cs"/>
        <AdditionalFiles Remove="Content\Other content folders"/>
        <AdditionalFiles Remove="Content\Data\SBC files can go here"/>
        <AdditionalFiles Remove="Content\Data\SBC files can go here"/>
        <None Remove="thumb.jpg"/>
        <None Remove="thumb.png"/>
        <None Remove="readme.txt"/>

        <!-- why keen? why chinese language is not up to spec? ...  -->
        <AdditionalFiles Remove="Content\Data\Localization\MyTexts.zh.resx"/>
    </ItemGroup>

    <Target Name="MapzhTozhCN" BeforeTargets="PostBuildEvent">
        <Copy SourceFiles="$(MSBuildProjectDirectory)\Content\Data\Localization\MyTexts.zh.resx" DestinationFiles="$(MSBuildProjectDirectory)\Content\Data\Localization\MyTexts.zh-CN.resx" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="Mapjpgtopng" BeforeTargets="PostBuildEvent">
        <Copy SourceFiles="$(MSBuildProjectDirectory)\thumb.jpg" DestinationFiles="$(MSBuildProjectDirectory)\thumb.png" SkipUnchangedFiles="true" />
    </Target>
    
    <ItemGroup>
        <ProjectReference Include="..\LcdMod.CodeGenerator\LcdMod.CodeGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
            <SetPlatform>Platform=AnyCPU</SetPlatform>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Client\**\*.acrux.xaml" />
        <AdditionalFiles Include="Client\Apps\**\*View.xaml" />
        <!-- .axaml: same ADK views, named the way Avalonia tooling (the IDE previewer) recognises them. -->
        <AdditionalFiles Include="Client\**\*.acrux.axaml" />
        <AdditionalFiles Include="Client\Apps\**\*View.axaml" />
    </ItemGroup>
    
    <ItemGroup>
      <EmbeddedResource Update="Content\Data\Localization\MyTexts.zh.resx">
        <DependentUpon>MyTexts.resx</DependentUpon>
      </EmbeddedResource>
    </ItemGroup>
    
    <ItemGroup>
      <Compile Remove="Client\Gui\ControlsTemplates\ControlStyleOverride.cs" />
      <Compile Remove="Client\Terminal\Controls\Generic\SliderImageChangeInterval.cs" />
      <Compile Remove="Client\Terminal\Controls\Groups\ColorsTerminalControlGroup.cs" />
      <Compile Remove="Client\Terminal\Controls\Groups\GpsDisplayTerminalControlGroup.cs" />
      <Compile Include="..\External\AcruxUI\External\SE-Water\API\WaterModAPI.cs" Link="Client\Api\WaterModAPI.cs" />
    </ItemGroup>

    <Target Name="RemoveZhCnResxAlias" AfterTargets="MdkPack;MdkDidNotPack">
        <Delete Files="$(MSBuildProjectDirectory)\Content\Data\Localization\MyTexts.zh-CN.resx" />
    </Target>

    <Target Name="RemoveThumbAlias" AfterTargets="MdkPack;MdkDidNotPack">
        <Delete Files="$(MSBuildProjectDirectory)\thumb.png" />
    </Target>

    <Target Name="WriteReadme" BeforeTargets="PostBuildEvent">
        <WriteLinesToFile
                File="readme.txt"
                Lines="The content of this folder is generated automatically by MDK using attached Analyzers/Code generators
Do not edit it manually, use the mod source on 'https://github.com/ArthurGamerHD/Arthur-s-Lcd-Mod' instead"
                Overwrite="true"
                Encoding="Unicode"/>
    </Target>
    
    <Target Name="RemoveReadmeAlias" AfterTargets="MdkPack;MdkDidNotPack">
        <Delete Files="$(MSBuildProjectDirectory)\readme.txt" />
    </Target>
    
    <Import Project="..\External\AcruxUI\External\Adk\Adk.CodeGeneration.props" />
    <Import Project="..\External\AcruxUI\External\Adk\Adk.Audio\Adk.Audio.projitems" Label="Shared" />
    <Import Project="..\External\CAudioVisualizer.SE\CAudioVisualizer.Core\CAudioVisualizer.Core.projitems" Label="Shared" />
    <Import Project="..\External\CAudioVisualizer.SE\CAudioVisualizer.SpaceEngineers\CAudioVisualizer.SpaceEngineers.projitems" Label="Shared" />
    <Import Project="..\External\AcruxUI\External\Adk\Adk.Compression\Adk.Compression.projitems" Label="Shared" />
    <Import Project="..\External\AcruxUI\External\Adk\Adk.Image\Adk.Image.projitems" Label="Shared" />
    <!-- UI comes from Acrux UI mod: thin generated wrappers + bridge runtime. -->
    <PropertyGroup>
        <AcruxUiToolkitRoot Condition="'$(AcruxUiToolkitRoot)' == ''">$(MSBuildProjectDirectory)\..\External\AcruxUI</AcruxUiToolkitRoot>
    </PropertyGroup>
    <Import Project="$(AcruxUiToolkitRoot)\ClientApi\ClientApi.projitems" Label="Shared" />
    <Import Project="$(AcruxUiToolkitRoot)\Framework\Acrux.Generator\Acrux.Generator.props" />
    <!-- IDE preview of ADK .axaml views (dev-time only), themed as an app on a surface. -->
    <PropertyGroup>
        <AcruxPreviewDesignResources>LcdMod.Client.Gui.Styling.DesignThemeResources</AcruxPreviewDesignResources>
        <!-- App views previewed as on the LCD: on the surface grid, inside the app shell (title, background layer, footer). -->
        <AcruxPreviewDesignHost>LcdMod.Client.Apps.Views.DesignAppHost</AcruxPreviewDesignHost>
    </PropertyGroup>
    <Import Project="$(AcruxUiToolkitRoot)\Tools\AcruxPreviewHost\AcruxPreview.props" Condition="'$(Configuration)' == 'Debug' And Exists('$(AcruxUiToolkitRoot)\Tools\AcruxPreviewHost\AcruxPreview.props')" />
    <Import Project="..\External\AcruxUI\External\Adk\Adk.Video\Adk.Video.projitems" Label="Shared" />
    <Import Project="..\External\AcruxUI\External\SE-Procedural-Voxel-Cubemap-Api\ClientApi\ClientApi.projitems" Label="Shared" />
</Project>
